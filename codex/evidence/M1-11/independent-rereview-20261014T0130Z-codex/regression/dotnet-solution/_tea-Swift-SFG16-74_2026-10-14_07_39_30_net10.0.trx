                  JOIN "AccessTeachers" g ON g."Id"=teacher."GrantId" AND g."TeacherId"=teacher."TeacherId" AND g."CourseId"=teacher."CourseId"
                      AND g."GroupId" IS NOT DISTINCT FROM teacher."GroupId"
