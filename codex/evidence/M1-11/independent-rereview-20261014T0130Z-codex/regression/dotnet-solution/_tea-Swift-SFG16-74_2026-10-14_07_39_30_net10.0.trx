      SELECT p."Id", p."ContentJson", p."CourseId", p."PublishedAt", p."SourceRevision", p."VersionNumber"
      FROM "PublishedContentVersions" AS p
      WHERE p."Id" = @id AND p."CourseId" = @courseId
      LIMIT 2
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (0ms) [Parameters=[@workId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT m."Id", m."AttachmentIds", m."AuthorId", m."AuthorRole", m."BodyMarkdown", m."CreatedAt", m."ProblemWorkId", m."ReplyToMessageId", p2."Id"
      FROM (
          SELECT p."Id"
          FROM "ProblemWorks" AS p
          WHERE p."Id" = @workId
          ORDER BY p."Id"
          LIMIT 1
      ) AS p2
      INNER JOIN "Messages" AS m ON p2."Id" = m."ProblemWorkId"
      ORDER BY p2."Id", m."CreatedAt", m."Id"
