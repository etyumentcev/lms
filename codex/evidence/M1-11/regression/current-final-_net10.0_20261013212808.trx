          WHERE w."Status" = 'Submitted' AND (
              (NOT EXISTS (SELECT 1 FROM "AssignmentScopes" scoped WHERE scoped."AssignmentId"=a."Id") AND EXISTS (
                  SELECT 1 FROM "AccessTeachers" g WHERE g."TeacherId" = @p0 AND g."CourseId" = a."CourseId"
