      WHERE l."CourseId" ILIKE @search ESCAPE '\' OR l."StudentDisplayName" ILIKE @search ESCAPE '\' OR l."CourseTitle" ILIKE @search ESCAPE '\' OR l."LessonId" ILIKE @search ESCAPE '\' OR l."LessonTitle" ILIKE @search ESCAPE '\' OR l."ProblemId" ILIKE @search ESCAPE '\' OR l."ProblemTitle" ILIKE @search ESCAPE '\' OR l."StudentId"::text ILIKE @search ESCAPE '\'
