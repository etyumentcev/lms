      Executed DbCommand (1ms) [Parameters=[@assignmentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id", s."AttachmentIds", s."AttemptNumber", s."BodyMarkdown", s."ProblemWorkId", s."SubmittedAt", s."SubmittedBy", p0."Id"
      FROM (
          SELECT p."Id"
          FROM "ProblemWorks" AS p
          WHERE p."ProblemAssignmentId" = @assignmentId
          ORDER BY p."Id"
