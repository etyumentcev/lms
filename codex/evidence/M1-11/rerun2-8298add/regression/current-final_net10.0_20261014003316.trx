      SELECT a."AssignmentId", a."CourseId", a."EnrollmentGeneration", a."GroupId", a."MembershipGeneration", a."OrganizationId", a."StudentId"
      FROM "AssignmentScopes" AS a
      INNER JOIN "ProblemAssignments" AS p ON a."AssignmentId" = p."Id"
