      Executed DbCommand (0ms) [Parameters=[@id='?' (DbType = Guid), @courseId='?'], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."ContentJson", p."CourseId", p."PublishedAt", p."SourceRevision", p."VersionNumber"
