      WHERE c."CourseId" = @resource_CourseId AND c."OrganizationId" = @resource_OrganizationId AND p."OrganizationId" = @resource_OrganizationId AND c0."OrganizationId" = @resource_OrganizationId3 AND c0."MappingState" = 'Verified' AND c."EffectiveFrom" &lt;= @time_Latest AND (c."EffectiveTo" IS NULL OR c."EffectiveTo" &gt; @time_Earliest)
