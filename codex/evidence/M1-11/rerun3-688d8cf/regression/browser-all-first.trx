      SELECT c."ContextId", c."EffectiveFrom", c."EffectiveTo", p."EffectiveFrom" AS "ContextFrom", p."SyntheticOnly", p."ApprovalState"
      FROM "CourseContextBindings" AS c
      INNER JOIN "ProcessingContextVersions" AS p ON c."ContextId" = p."ContextId" AND c."ContextVersion" = p."Version"
      INNER JOIN "CourseRegistry" AS c0 ON c."CourseId" = c0."CourseId"
      WHERE c."CourseId" = @resource_CourseId AND c."OrganizationId" = @resource_OrganizationId AND p."OrganizationId" = @resource_OrganizationId AND c0."OrganizationId" = @resource_OrganizationId3 AND c0."MappingState" = 'Verified' AND c."EffectiveFrom" &lt;= @time_Latest AND (c."EffectiveTo" IS NULL OR c."EffectiveTo" &gt; @time_Earliest)
