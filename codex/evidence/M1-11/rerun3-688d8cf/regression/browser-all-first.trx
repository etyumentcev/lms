                      WHERE a1."Id" = t."GrantId" AND a1."TeacherId" = @actor_Id AND a1."CourseId" = t."CourseId" AND (a1."GroupId" = t."GroupId" OR (a1."GroupId" IS NULL AND t."GroupId" IS NULL))) AND EXISTS (
