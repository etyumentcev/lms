      SELECT EXISTS (
          SELECT 1
          FROM "ProcessingRestrictions" AS p
          WHERE p."OrganizationId" = @resource_OrganizationId AND p."ContextId" = @binding_ContextId AND p."State" = 'Active' AND (p."SubjectActorId" IS NULL OR p."SubjectActorId" = @actorId OR p."SubjectActorId" = @resource_StudentId))
