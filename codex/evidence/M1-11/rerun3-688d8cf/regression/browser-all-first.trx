      SELECT a."CourseId", a."CourseVersionId", a."LessonId", a."AvailableFrom", a."IsPublished"
      FROM "AccessLessons" AS a
      WHERE a."CourseId" = @assignment_CourseId AND a."CourseVersionId" = @assignment_Content_CourseVersionId AND a."LessonId" = @assignment_Content_LessonId
      LIMIT 2
