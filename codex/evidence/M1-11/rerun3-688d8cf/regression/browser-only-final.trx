      SELECT c."ContextId", c."EffectiveFrom", c."EffectiveTo", p."EffectiveFrom" AS "ContextFrom", p."SyntheticOnly", p."ApprovalState"
      FROM "CourseContextBindings" AS c
      INNER JOIN "ProcessingContextVersions" AS p ON c."ContextId" = p."ContextId" AND c."ContextVersion" = p."Version"
      INNER JOIN "CourseRegistry" AS c0 ON c."CourseId" = c0."CourseId"
      WHERE c."CourseId" = @resource_CourseId AND c."OrganizationId" = @resource_OrganizationId AND p."OrganizationId" = @resource_OrganizationId AND c0."OrganizationId" = @resource_OrganizationId3 AND c0."MappingState" = 'Verified' AND c."EffectiveFrom" &lt;= @time_Latest AND (c."EffectiveTo" IS NULL OR c."EffectiveTo" &gt; @time_Earliest)
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@resource_OrganizationId='?' (DbType = Guid), @binding_ContextId='?' (DbType = Guid), @actorId='?' (DbType = Guid), @resource_StudentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT EXISTS (
          SELECT 1
          FROM "ProcessingRestrictions" AS p
          WHERE p."OrganizationId" = @resource_OrganizationId AND p."ContextId" = @binding_ContextId AND p."State" = 'Active' AND (p."SubjectActorId" IS NULL OR p."SubjectActorId" = @actorId OR p."SubjectActorId" = @resource_StudentId))
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@assignmentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."CourseId", p."Status", p."StudentId", p."CourseVersionId", p."LessonId", p."ProblemId"
      FROM "ProblemAssignments" AS p
      WHERE p."Id" = @assignmentId
      LIMIT 2
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT a."AssignmentId", a."CourseId", a."EnrollmentGeneration", a."GroupId", a."MembershipGeneration", a."OrganizationId", a."StudentId"
      FROM "AssignmentScopes" AS a
      INNER JOIN "ProblemAssignments" AS p ON a."AssignmentId" = p."Id"
      WHERE a."AssignmentId" = @id AND a."StudentId" = p."StudentId" AND a."CourseId" = p."CourseId"
      LIMIT 2
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@assignmentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."AcceptedAt", p."ProblemAssignmentId", p."Status", p."StudentId", p."Version"
      FROM "ProblemWorks" AS p
      WHERE p."ProblemAssignmentId" = @assignmentId
      ORDER BY p."Id"
      LIMIT 2
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@assignmentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id", s."AttachmentIds", s."AttemptNumber", s."BodyMarkdown", s."ProblemWorkId", s."SubmittedAt", s."SubmittedBy", p0."Id"
      FROM (
          SELECT p."Id"
          FROM "ProblemWorks" AS p
          WHERE p."ProblemAssignmentId" = @assignmentId
          ORDER BY p."Id"
          LIMIT 1
      ) AS p0
      INNER JOIN "Submissions" AS s ON p0."Id" = s."ProblemWorkId"
      ORDER BY p0."Id"
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@assignmentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT r."Id", r."Annotations", r."CreatedAt", r."Decision", r."MessageId", r."ProblemWorkId", r."SubmissionId", r."TeacherId", p1."Id"
      FROM (
          SELECT p."Id"
          FROM "ProblemWorks" AS p
          WHERE p."ProblemAssignmentId" = @assignmentId
          ORDER BY p."Id"
          LIMIT 1
      ) AS p1
      INNER JOIN "Reviews" AS r ON p1."Id" = r."ProblemWorkId"
      ORDER BY p1."Id"
