      Executed DbCommand (6ms) [Parameters=[@resource_OrganizationId='?' (DbType = Guid), @courseId='?', @resource_GroupId='?', @token_Identity_ActorId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."CourseVersionId", p0."VersionNumber", p."LessonId", p."ProblemId", p0."ContentJson", CASE
          WHEN p1."Id" IS NULL THEN 'NotStarted'
          ELSE p1."Status"
      END AS "Status", CASE
          WHEN p1."Id" IS NULL THEN 0
          ELSE (
              SELECT count(*)::int
              FROM "Submissions" AS s
              WHERE p1."Id" IS NOT NULL AND p1."Id" = s."ProblemWorkId")
      END AS "AttemptCount"
      FROM "ProblemAssignments" AS p
      INNER JOIN "PublishedContentVersions" AS p0 ON p."CourseVersionId" = p0."Id"
      INNER JOIN (
          SELECT l."CourseId", l."ContentVersionId", l."LessonId"
