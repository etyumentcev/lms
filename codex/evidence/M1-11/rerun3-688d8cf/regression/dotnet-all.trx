      INNER JOIN "CourseRegistry" AS c ON t."CourseId" = c."CourseId"
      WHERE t."TeacherId" = @actor AND t."OrganizationId" = @org AND t."State" = 'Active' AND t."MembershipGeneration" = @m_Generation AND t."RevocationRequestedAt" IS NULL AND t."AccessValidUntil" IS NULL AND a."TeacherId" = @actor AND a."CourseId" = t."CourseId" AND (a."GroupId" = t."GroupId" OR (a."GroupId" IS NULL AND t."GroupId" IS NULL)) AND c."OrganizationId" = @org4 AND c."MappingState" = 'Verified'
