info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@courseId='?', @actor_Id='?' (DbType = Guid), @_8__locals1_lessonId='?', @ids='?' (DbType = Object)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."CourseId", p."Status", p."StudentId", p."CourseVersionId", p."LessonId", p."ProblemId"
      FROM "ProblemAssignments" AS p
      WHERE p."CourseId" = @courseId AND p."Status" = 'Active' AND CASE
          WHEN EXISTS (
              SELECT 1
              FROM "AssignmentScopes" AS a
              WHERE a."AssignmentId" = p."Id") THEN EXISTS (
              SELECT 1
              FROM "AssignmentScopes" AS a0
              WHERE a0."AssignmentId" = p."Id" AND EXISTS (
                  SELECT 1
                  FROM "TeacherAssignmentScopes" AS t
                  WHERE t."TeacherId" = @actor_Id AND t."CourseId" = p."CourseId" AND t."OrganizationId" = a0."OrganizationId" AND t."State" = 'Active' AND t."RevocationRequestedAt" IS NULL AND t."AccessValidUntil" IS NULL AND (t."GroupId" IS NULL OR t."GroupId" = a0."GroupId") AND EXISTS (
                      SELECT 1
                      FROM "AccessTeachers" AS a1
                      WHERE a1."Id" = t."GrantId" AND a1."TeacherId" = @actor_Id AND a1."CourseId" = t."CourseId" AND (a1."GroupId" = t."GroupId" OR (a1."GroupId" IS NULL AND t."GroupId" IS NULL))) AND EXISTS (
                      SELECT 1
                      FROM "OrganizationMemberships" AS o
                      WHERE o."OrganizationId" = t."OrganizationId" AND o."ActorId" = @actor_Id AND o."Generation" = t."MembershipGeneration" AND o."State" = 'Active' AND o."RevocationRequestedAt" IS NULL AND o."AccessValidUntil" IS NULL) AND EXISTS (
                      SELECT 1
                      FROM "CourseRegistry" AS c
                      WHERE c."CourseId" = t."CourseId" AND c."OrganizationId" = t."OrganizationId" AND c."MappingState" = 'Verified')))
          ELSE EXISTS (
              SELECT 1
              FROM "AccessTeachers" AS a2
              WHERE a2."TeacherId" = @actor_Id AND a2."CourseId" = p."CourseId" AND (a2."GroupId" IS NULL OR EXISTS (
                  SELECT 1
                  FROM "AccessEnrollments" AS a3
                  WHERE a3."StudentId" = p."StudentId" AND a3."CourseId" = p."CourseId" AND a3."IsActive" AND a3."GroupId" = a2."GroupId")))
      END AND p."LessonId" = @_8__locals1_lessonId AND p."CourseVersionId" = ANY (@ids)
