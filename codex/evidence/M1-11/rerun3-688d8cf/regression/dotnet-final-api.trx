              s."AttemptNumber", s."SubmittedAt", cardinality(s."AttachmentIds") AS "AttachmentCount", w."Version"
          FROM "ProblemWorks" w
          JOIN "ProblemAssignments" a ON a."Id" = w."ProblemAssignmentId"
          JOIN "Submissions" s ON s."ProblemWorkId" = w."Id"
