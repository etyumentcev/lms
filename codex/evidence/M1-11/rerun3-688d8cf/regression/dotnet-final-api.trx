info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@courseId='?', @actor_Id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT p."Id", p."CourseVersionId", p."LessonId", CASE
          WHEN p0."Id" IS NULL THEN 'NotStarted'
          ELSE p0."Status"
      END
      FROM "ProblemAssignments" AS p
      LEFT JOIN "ProblemWorks" AS p0 ON p."Id" = p0."ProblemAssignmentId"
      WHERE p."CourseId" = @courseId AND p."Status" = 'Active' AND p."StudentId" = @actor_Id
