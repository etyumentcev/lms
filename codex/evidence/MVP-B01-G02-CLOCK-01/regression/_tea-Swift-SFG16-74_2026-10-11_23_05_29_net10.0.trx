      Executed DbCommand (6ms) [Parameters=[@ids='?' (DbType = Object), @actor_Id='?' (DbType = Guid), @now='?' (DbType = DateTime)], CommandType='Text', CommandTimeout='30']
      SELECT count(*)::int
      FROM "AccessAttachments" AS a
