          LEFT JOIN "AccessEnrollments" e ON e."StudentId" = a."StudentId" AND e."CourseId" = a."CourseId"
          LEFT JOIN "PublishedContentVersions" v ON v."Id" = a."CourseVersionId" AND v."CourseId" = a."CourseId"
