          WHERE w."Status" = 'Submitted' AND EXISTS (
              SELECT 1 FROM "AccessTeachers" g WHERE g."TeacherId" = @p0 AND g."CourseId" = a."CourseId"
              AND (g."GroupId" IS NULL OR (e."IsActive" AND e."GroupId" = g."GroupId")))
      ) AS l
