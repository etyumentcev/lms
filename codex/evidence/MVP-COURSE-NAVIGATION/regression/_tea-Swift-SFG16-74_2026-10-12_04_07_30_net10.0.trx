info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@actor_Id='?' (DbType = Guid), @assignment_CourseId='?', @assignment_StudentId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT EXISTS (
          SELECT 1
          FROM "AccessTeachers" AS a
          WHERE a."TeacherId" = @actor_Id AND a."CourseId" = @assignment_CourseId AND (a."GroupId" IS NULL OR EXISTS (
              SELECT 1
              FROM "AccessEnrollments" AS a0
              WHERE a0."StudentId" = @assignment_StudentId AND a0."CourseId" = @assignment_CourseId AND a0."IsActive" AND a0."GroupId" = a."GroupId")))
