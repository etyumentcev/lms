      SELECT l."AttemptNumber", l."CourseId", l."CourseTitle", l."GroupId", l."LessonId", l."LessonTitle", l."ProblemId", l."ProblemTitle", l."ProblemWorkId", l."StudentId", l."SubmissionId", l."SubmittedAt", l."Version"
