      SELECT r."Id", r."Annotations", r."CreatedAt", r."Decision", r."MessageId", r."ProblemWorkId", r."SubmissionId", r."TeacherId", p1."Id"
      FROM (
          SELECT p."Id"
          FROM "ProblemWorks" AS p
          WHERE p."Id" = @workId
          ORDER BY p."Id"
          LIMIT 1
      ) AS p1
      INNER JOIN "Reviews" AS r ON p1."Id" = r."ProblemWorkId"
      ORDER BY p1."Id", (
          SELECT s0."AttemptNumber"
          FROM "Submissions" AS s0
          WHERE s0."Id" = r."SubmissionId"
          LIMIT 1)
