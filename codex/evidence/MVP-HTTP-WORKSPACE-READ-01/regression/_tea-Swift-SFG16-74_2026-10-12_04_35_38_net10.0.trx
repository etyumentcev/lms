              v."ContentJson"-&gt;&gt;'title' AS "CourseTitle", a."LessonId", lesson.data-&gt;&gt;'title' AS "LessonTitle",
              e."GroupId", a."ProblemId", problem.data-&gt;&gt;'title' AS "ProblemTitle",
