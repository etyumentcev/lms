info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1ms) [Parameters=[@workId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT s."Id", s."AttachmentIds", s."AttemptNumber", s."BodyMarkdown", s."ProblemWorkId", s."SubmittedAt", s."SubmittedBy", p0."Id"
      FROM (
          SELECT p."Id"
          FROM "ProblemWorks" AS p
          WHERE p."Id" = @workId
          ORDER BY p."Id"
          LIMIT 1
      ) AS p0
      INNER JOIN "Submissions" AS s ON p0."Id" = s."ProblemWorkId"
      ORDER BY p0."Id", s."AttemptNumber"
