          WHEN p0."Id" IS NULL THEN 'NotStarted'
          ELSE p0."Status"
      END
      FROM "ProblemAssignments" AS p
      LEFT JOIN "ProblemWorks" AS p0 ON p."Id" = p0."ProblemAssignmentId"
      WHERE p."CourseId" = @courseId AND p."Status" = 'Active' AND EXISTS (
          SELECT 1
          FROM "AccessTeachers" AS a
          WHERE a."TeacherId" = @actor_Id AND a."CourseId" = p."CourseId" AND (a."GroupId" IS NULL OR EXISTS (
              SELECT 1
              FROM "AccessEnrollments" AS a0
              WHERE a0."StudentId" = p."StudentId" AND a0."CourseId" = p."CourseId" AND a0."IsActive" AND a0."GroupId" = a."GroupId")))
