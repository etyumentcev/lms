      Executed DbCommand (1ms) [Parameters=[@_8__locals1_courseId='?'], CommandType='Text', CommandTimeout='30']
      SELECT a."CourseId", a."CourseVersionId", a."LessonId", a."AvailableFrom", a."IsPublished"
