{
  "realm": "sapientum-local",
  "enabled": true,
  "displayName": "Sapientum Local Synthetic",
  "sslRequired": "all",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for basic token claims",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "organization:bootstrap",
      "description": "Create the first administrator of a synthetic organization",
      "protocol": "openid-connect",
      "attributes": {
        "display.on.consent.screen": "false",
        "include.in.token.scope": "true"
      }
    }
  ],
  "clients": [
    {
      "clientId": "sapientum-platform",
      "name": "Sapientum platform API audience",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "sapientum-platform-cli",
      "name": "Sapientum local platform operator",
      "enabled": true,
      "fullScopeAllowed": false,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "organization:bootstrap"],
      "protocolMappers": [
        {
          "name": "sapientum-platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "sapientum-platform",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "platform.operator",
      "enabled": true,
      "firstName": "Local",
      "lastName": "Operator",
      "email": "platform.operator@local.invalid",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "__PLATFORM_OPERATOR_PASSWORD__",
          "temporary": false
        }
      ]
    }
  ]
}
